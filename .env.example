# 🚀 Ultimate Expo Template Environment Variables
# Copy this file to .env and fill in your credentials.

# --- AUTHENTICATION (Provider Agnostic) ---
# Use either CLERK or SUPABASE based on your preference

# Clerk Auth
# Get these from https://dashboard.clerk.com
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Supabase Auth & Storage
# Get these from https://supabase.com/dashboard
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- EXTERNAL SERVICES ---

# Sentry DSN (Error Tracking)
# Get this from https://sentry.io
EXPO_PUBLIC_SENTRY_DSN=

# PostHog Project API Key (Analytics)
# Get this from https://app.posthog.com
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- APP CONFIGURATION ---

# App Scheme (The slug you use for deep linking)
EXPO_PUBLIC_APP_SCHEME=expo-template

# Toggle for Mock Auth (development only)
EXPO_PUBLIC_USE_MOCK_AUTH=true
