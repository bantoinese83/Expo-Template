# 🚀 Ultimate Expo Template Environment Variables
# Copy this file to .env and fill in your credentials.

# Sentry Build Configuration
# Set to true for local development to skip source map uploads and prevent build failures
SENTRY_DISABLE_AUTO_UPLOAD=true

# --- AUTHENTICATION (all optional for mock-only dev) ---
# Omit Clerk and Supabase entirely, or set one provider when you wire it up.
# If you set Supabase, set BOTH URL and anon key (see src/config/env.ts).

# Clerk — https://dashboard.clerk.com
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Supabase — https://supabase.com/dashboard
# EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- EXTERNAL SERVICES ---

# Sentry DSN (Error Tracking)
# Get this from https://sentry.io
EXPO_PUBLIC_SENTRY_DSN=

# PostHog Project API Key (Analytics)
# Get this from https://app.posthog.com
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- APP CONFIGURATION ---

# App Scheme (The slug you use for deep linking)
EXPO_PUBLIC_APP_SCHEME=expo-template

# Toggle for Mock Auth (development only)
EXPO_PUBLIC_USE_MOCK_AUTH=true
