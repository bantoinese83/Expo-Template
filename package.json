{
  "name": "expo-template",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "SENTRY_DISABLE_AUTO_UPLOAD=true expo run:android",
    "ios": "SENTRY_DISABLE_AUTO_UPLOAD=true expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json}\" --ignore-path .prettierignore",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "clean": "rm -rf node_modules .expo ios/build android/build && npm install",
    "generate": "npx expo-assets",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "maestro test .maestro/",
    "check-all": "npm run lint && npm run check-types && npm run format:check && npm run test",
    "prepare": "husky",
    "generate:api": "orval",
    "deploy": "eas build --profile production",
    "generate:feature": "node scripts/generate-feature.js",
    "init-app": "node scripts/customize-app.js"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.31",
    "@expo/ui": "~55.0.0",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/stack": "^7.4.8",
    "@sentry/react-native": "~7.2.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.101.1",
    "@tanstack/query-async-storage-persister": "^5.96.2",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-query-persist-client": "^5.96.2",
    "axios": "^1.14.0",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-react-compiler": "^19.0.0-beta-af1b7da-20250417",
    "babel-preset-expo": "~55.0.8",
    "drizzle-orm": "^0.45.2",
    "expo": "~55.0.0",
    "expo-asset": "~55.0.16",
    "expo-auth-session": "~55.0.15",
    "expo-constants": "~55.0.15",
    "expo-crypto": "~55.0.14",
    "expo-dev-client": "~55.0.28",
    "expo-device": "~55.0.15",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "~55.0.17",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.9",
    "expo-image-picker": "~55.0.19",
    "expo-linear-gradient": "~55.0.0",
    "expo-linking": "~55.0.14",
    "expo-local-authentication": "~55.0.13",
    "expo-localization": "~55.0.13",
    "expo-notifications": "~55.0.20",
    "expo-router": "~55.0.13",
    "expo-secure-store": "~55.0.13",
    "expo-sqlite": "~55.0.15",
    "expo-status-bar": "~55.0.5",
    "expo-updates": "~55.0.21",
    "expo-web-browser": "~55.0.14",
    "husky": "^9.1.7",
    "i18next": "^26.0.3",
    "jest-expo": "~55.0.16",
    "lint-staged": "^16.4.0",
    "lucide-react-native": "^1.7.0",
    "moti": "^0.30.0",
    "nativewind": "^4.2.3",
    "posthog-react-native": "^4.44.3",
    "premium-ui": "./modules/premium-ui",
    "react": "19.2.0",
    "react-compiler-runtime": "^19.0.0-beta-af1b7da-20250417",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.72.1",
    "react-i18next": "^17.0.2",
    "react-native": "0.83.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.35.4",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "0.7.4",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "private": true,
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "ajv-draft-04": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.0.0-beta-af1b7da-20250417",
    "eslint-plugin-react-native": "^5.0.0",
    "expo-drizzle-studio-plugin": "^0.2.1",
    "globals": "^17.4.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.0",
    "jsdom": "^29.0.1",
    "orval": "^8.6.2",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "react-test-renderer": "^19.1.0",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.58.0"
  },
  "expo": {
    "autolinking": {
      "searchPaths": [
        "./node_modules",
        "./modules"
      ]
    }
  }
}
